fn text_value(observed: snapshot) = field(value: observed, name: "value")

fn replace_text(target: object, text: string) = bind(
  before: gui.observe(target: target),
  body: bind(
    submitted: gui.set_text(
      target: target,
      expected_revision: field(value: before, name: "revision"),
      text: text
    ),
    body: bind(
      after: gui.observe(target: target),
      body: eq(left: text_value(observed: after), right: text)
    )
  )
)

fn main(name: string, text: string) = bind(
  target: gui.find(name: name),
  body: replace_text(target: target, text: text)
)
